# Generated / project-level docs (do not track generated files)
docs/*
!docs/column/
!docs/demo.png
!docs/readr-logo.svg


# your research vault 

# Source materials (files under subdirectories are ignored individually)
# PDFs are large; excluded from version control by default
# To track: remove lines below or use `git add -f`

sources/*/*
!sources/Vaswani et al. - 2023 - Attention Is All You Need.pdf
!sources/Dosovitskiy et al. - 2021 - An Image is Worth 16x16 Words Transformers for Image Recognition at Scale.pdf

# library（do not push your works to open platform）
library/*/*
!library/_template
!library/*/readme.md
!library/entries/your_direction
!library/entries/cv
!library/entries/nlp
library/entries/nlp/*
!library/entries/nlp/Attention Is All You Need (NeurIPS 2017).md

# annotations（do not push your works to open platform）
annotations/*
!annotations/_template
!annotations/your_direction
!annotations/cv

# literature review（do not push your works to open platform）
reviews/*
!reviews/templates