.agent
.agents
AGENTS.md
.idea
.mcp.json
.claudian
.claude/

# RSS Dashboard cache
.rss-dashboard-data/

# Generated / project-level docs (do not track generated files)
docs/*
docs/plan.md
docs/specs.md
docs/literature-review/
!docs/demo.png

# Source materials (files under subdirectories are ignored individually)
sources/*/*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

